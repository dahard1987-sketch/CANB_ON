# 서비스 계정 키는 웹 브라우저가 접근할 수 없는 서버 경로에 두세요.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_SPREADSHEET_ID=YOUR_SPREADSHEET_ID

# 사이트 비밀번호의 SHA-256 해시와 Flask 세션 서명 키입니다.
# 원문 비밀번호는 파일이나 GitHub에 저장하지 않습니다.
APP_PASSWORD_SHA256=YOUR_PASSWORD_SHA256
APP_SESSION_SECRET=YOUR_RANDOM_SESSION_SECRET

# 기본값은 로컬 PC에서만 접속 가능한 127.0.0.1:5000입니다.
HOST=127.0.0.1
PORT=5000
MAX_UPLOAD_BYTES=104857600

# Cloud Run/Compute의 연결된 서비스 계정을 쓸 때만 활성화합니다.
# 이 경우 GOOGLE_SERVICE_ACCOUNT_FILE은 필요하지 않습니다.
GOOGLE_USE_ADC=0
